# ---------------------------------------------------------------------------
# Ayonix Zoomer - local development (.dev.vars) / Workers secrets
# Copy to `.dev.vars` for `vite dev`; set the same names with
# `wrangler secret put <NAME>` for deployed environments. Never commit real values.
# ---------------------------------------------------------------------------

# Zoom OAuth app (Zoom Marketplace > Develop > Build App > General App)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom app > Feature > Event Subscriptions > "Secret Token"
ZOOM_WEBHOOK_SECRET_TOKEN=

# 32-byte base64 key. Encrypts face templates and stored OAuth tokens at rest.
# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# 32-byte base64 key. Signs admin session cookies and trainee device tokens.
# Generate: openssl rand -base64 32
SESSION_SIGNING_KEY=

# Public origin the browser reaches. Must match the Zoom redirect allow-list.
PUBLIC_BASE_URL=http://localhost:5173
