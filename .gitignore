# dependencies
node_modules/

# build output
dist/
.wrangler/

# local secrets — never commit
# seed.sql is generated and carries the bootstrap password hash for a live
# deployment; generate it per environment with scripts/make-seed.mjs instead.
seed/seed.sql
.dev.vars
.dev.vars.*
.secrets/
.env
.env.local

# working artifacts
_src_mockup/
.playwright-mcp/
*.log
coverage/
*.png
!public/**/*.png

# os
.DS_Store

# tsc must never emit next to the sources: Vite resolves `@/x` to a stale x.js
# before x.tsx, so an accidental emit silently serves old code in dev.
src/**/*.js
src/**/*.d.ts
worker/**/*.js
worker/**/*.d.ts
tests/**/*.js
tests/**/*.d.ts
/vite.config.js
/vitest.config.js
/drizzle.config.js
*.tsbuildinfo
