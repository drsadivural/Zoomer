# Zoom Meeting SDK app (Marketplace → Meeting SDK app)
ZOOM_SDK_KEY=your_sdk_key
ZOOM_SDK_SECRET=your_sdk_secret
# Meeting to join (the bot joins as a hidden participant)
ZOOM_MEETING_NUMBER=99988877766
ZOOM_MEETING_PASSCODE=
BOT_DISPLAY_NAME=Ayonix Monitor
# Optional: local-recording / join token if your account requires it
ZOOM_JOIN_TOKEN=
# Zoomer backend
ZOOMER_BASE_URL=https://zoomer.ayonix.com
BOT_INGEST_TOKEN=paste_the_backend_BOT_INGEST_TOKEN
# UXE engine (server.py --mode json)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=9101
# Cadence
FRAME_STRIDE=8
REAUTH_INTERVAL_SEC=30
EVIDENCE_INTERVAL_SEC=300
