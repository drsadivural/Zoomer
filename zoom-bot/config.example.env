# Zoom Meeting SDK app (Marketplace -> Meeting SDK app, NOT the OAuth app).
ZOOM_SDK_KEY=your_sdk_key
ZOOM_SDK_SECRET=your_sdk_secret

# Zoomer backend
ZOOMER_BASE_URL=https://zoomer.ayonix.com
BOT_INGEST_TOKEN=paste_the_backend_BOT_INGEST_TOKEN

# --- Assignment mode (default) -------------------------------------------
# Leave ZOOM_MEETING_NUMBER unset and the bot polls
# GET /api/v1/bot/assignments, joining whichever meeting is live in a
# connected Zoom account. Nothing else needs configuring per customer.
ASSIGNMENT_POLL_SEC=20

# --- Pinned mode ----------------------------------------------------------
# Set both of these to keep the bot on one meeting instead. The organization id
# is required because a pinned meeting has no webhook or OAuth record to
# attribute it to a customer.
#ZOOM_MEETING_NUMBER=99988877766
#ZOOMER_ORGANIZATION_ID=org_0AYNXZMERDEFA0000000000000
#ZOOM_MEETING_PASSCODE=
#ZOOM_JOIN_TOKEN=

BOT_DISPLAY_NAME=Ayonix Monitor

# Analysis sidecar (analyzer/analyzer.py) — MediaPipe landmarks + UXE identity.
ANALYZER_HOST=127.0.0.1
ANALYZER_PORT=9102

# Cadence. In assignment mode the observe interval is overridden per meeting by
# the tenant's own monitoring settings.
OBSERVE_INTERVAL_SEC=10
# Identity is the expensive half of the analysis and a person does not change
# between frames, so it runs far less often than presence and eye state.
REAUTH_INTERVAL_SEC=60
# Live tiles for the organizer console. 0 disables snapshots entirely; the
# backend also refuses to refresh a tile more than once every 5 seconds.
SNAPSHOT_INTERVAL_SEC=30

# Frame handling
FRAME_MAX_EDGE=640
JPEG_QUALITY=75
# Treat a participant's video as stopped after this long with no frame.
VIDEO_STALL_SEC=15
